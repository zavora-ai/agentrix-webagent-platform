# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Comments sit on their own lines: systemd's EnvironmentFile does not strip trailing ones.
# Every model variable below has the same default in agentrix-models, so a missing line still
# works (specs/first-release/design.md §4.3, D10).

# --- Keys. Only agentrix-models reads the two model keys (R11.1). ---
# Vultr Serverless Inference: Vultr console > Serverless Inference > your subscription > API key.
VULTR_INFERENCE_API_KEY=
# Anthropic: console.anthropic.com > API keys.
ANTHROPIC_API_KEY=
# Vultr account API key, used only by deploy/ provisioning scripts.
VULTR_API_KEY=

# --- Provider and tiers (design §4.3). Callers name a purpose and maybe a tier, never a model. ---
# anthropic or vultr: the S3-10 switch moves every tier at once.
AGENTRIX_PROVIDER=anthropic
# Anthropic, per million tokens in / out: Opus $4 / $20, Sonnet $2 / $10, Haiku $0.10 / $0.50.
AGENTRIX_TIER_DEEP_ANTHROPIC=claude-opus-5-5
AGENTRIX_TIER_STANDARD_ANTHROPIC=claude-sonnet-5-5
AGENTRIX_TIER_FAST_ANTHROPIC=claude-haiku-5-5
# Vultr: glm-5.3 $0.75 / $3.00, qwen3.8-27b $0.15 / $1.00 (the bake-off may change it),
# deepseek-v4.1-flash-1017 $0.15 / $0.60.
AGENTRIX_TIER_DEEP_VULTR=glm-5.3
AGENTRIX_TIER_STANDARD_VULTR=qwen3.8-27b
AGENTRIX_TIER_FAST_VULTR=deepseek-v4.1-flash-1017
# Optional, one purpose at a time: AGENTRIX_ROUTE_<PURPOSE>=<provider>:<model>, for example
# AGENTRIX_ROUTE_BUILD=vultr:deepseek-v4.1-flash-1017

# --- Specialists: always on Vultr, whatever AGENTRIX_PROVIDER says. ---
AGENTRIX_EMBED=vultr:qwen3-embedding-4b
AGENTRIX_RERANK=vultr:bge-reranker-v2-m3
# `screen` and `decide` when the provider is vultr: the safety model and systemone.
AGENTRIX_SCREEN_VULTR=nemotron-3.5-content-safety
AGENTRIX_DECIDE_VULTR=clef
AGENTRIX_VECTOR_STORE=vultr
# Could this weekend:
AGENTRIX_IMAGE=vultr:qwen-image-2.1
AGENTRIX_IMAGE_FAST=vultr:z-image-turbo
AGENTRIX_STT=vultr:whisper-large-v3-turbo
AGENTRIX_STT_REALTIME=vultr:voxtral-mini-4b-realtime
AGENTRIX_TTS=vultr:qwen3-tts-12hz-1.7b
# Not this weekend:
AGENTRIX_VIDEO=vultr:minimax-h3

# --- Cost discipline in development (D10). ---
# live, record or replay. Tests and CI use replay, which needs no key and no network.
AGENTRIX_MODELS_MODE=live
# Where recordings live; by default crates/agentrix-models/recordings.
# AGENTRIX_MODELS_RECORDINGS=crates/agentrix-models/recordings
# The hard model-spend limit per site per day, in US dollars.
AGENTRIX_SITE_DAILY_CAP_USD=5
