# /etc/agentrix/node.env: agentrix-node's settings (no secrets). Installed by deploy/deploy.sh.
AGENTRIX_LISTEN=127.0.0.1:8080
AGENTRIX_INTERNAL_LISTEN=127.0.0.1:8079
AGENTRIX_DATA_DIR=/var/lib/agentrix
AGENTRIX_ORIGIN=https://agentrix.website
AGENTRIX_MODELS_URL=http://127.0.0.1:8090
AGENTRIX_RUNNER=http://10.42.0.4:7443
AGENTRIX_FIXTURE_DOMAIN=fixture.agentrix.website
RUST_LOG=info
# Sealed-room images on the sandbox, pinned by image ID (rooms never pull).
# Assess's room: Firefox, live frames (R1.4); the curl fallback is room-fetch@sha256:ec2bfd719644cf9c75a6a383a8e28ade5ac651ca028f8b0a80efb902b4cf677f.
AGENTRIX_IMAGE_FETCH=room-fetch-browser@sha256:cad23b062e300c523d00a43e65274eeb7f6a8257c44d6d98c7fa95f1e01ee757
AGENTRIX_IMAGE_RENDER=room-render@sha256:769d48258374761ed8b2784cc61136c2c84dbe859cb10ad26b5ea138105d3a3c
AGENTRIX_IMAGE_BUILD=room-build@sha256:fb1d600633b8ae8b35b68f1da8764b3d58f20b09a920e6a0eac333df616f5374
AGENTRIX_IMAGE_REPLAY=room-replay@sha256:0856e8d1a79a700e0a5f3592a0587c7e4eb5e1d03de128214712d05433195abf
# The fixture's exports, so a Move of Zavora's fixture needs no owner upload.
AGENTRIX_FIXTURE_EXPORTS=/var/lib/agentrix/fixture-exports
# The home page (agentrix-home, platform W10): the WhatsApp contact and its hours, and the film
# folder that deploy.sh --films fills (hero, film, classy, tana, salon .mp4).
AGENTRIX_HOME_WHATSAPP=+254721490933
AGENTRIX_HOME_WHATSAPP_HOURS="6am to 11pm EAT"
AGENTRIX_HOME_FILM_DIR=/var/lib/agentrix/film
# Recorded in the routing.changed receipt on every owned site when the gateway's routes change.
AGENTRIX_ROUTING_REASON="Agentrix moved its language models from Anthropic to Vultr Inference, which runs them in the US."
# Freeze and platform holds stop what they say on this build (handover-wiring 2b.1 and 3.2,
# 2cc6ed8), so the owner console offers Freeze and the operator console calls holds enforced (4.10).
AGENTRIX_FREEZE_ENFORCED=1
AGENTRIX_HOLDS_ENFORCED=1
