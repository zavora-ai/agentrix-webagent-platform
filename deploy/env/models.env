# /etc/agentrix/models.env: the Model Gateway's settings (no secrets). Installed by deploy/deploy.sh.
# Provider keys are in /etc/agentrix/secrets/models.env, never here.
AGENTRIX_MODELS_LISTEN=127.0.0.1:8090
AGENTRIX_CONTROL_DB=/var/lib/agentrix/control.db
AGENTRIX_MODELS_MODE=live
AGENTRIX_PROVIDER=vultr
RUST_LOG=info
