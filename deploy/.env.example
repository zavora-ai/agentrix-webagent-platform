# Copy to deploy/.env (git-ignored) and fill in. deploy/provision.sh parses this file; it is
# never sourced, and the key is never printed.

# Task S0-02, James only: a Vultr API key that can create instances, VPCs, firewall groups,
# SSH keys and DNS records. Nobody else types it. (The Inference key is separate: S0-05.)
VULTR_API_KEY=

# Region and plans (design §2; requirements §6 Q2). `deploy/provision.sh plan` shows prices
# and checks that each plan is available in the region.
VULTR_REGION=atl
CONTROL_PLAN=vhp-4c-8gb-intel
SANDBOX_PLAN=vx1-g-4c-16g-240s
FIXTURE_PLAN=vc2-1c-2gb
VULTR_OS_ID=2284

# Your public IPv4 as a /32. Control accepts SSH from it only; sandbox and fixture only through
# control. Remove the rule after deploys with: deploy/provision.sh ssh-close --yes
ADMIN_CIDR=
SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub

# Task S0-03: domains delegated to Vultr DNS. NAME is the label inside the zone; leave it empty
# for the zone apex. Example: PLATFORM_ZONE=example.com, PLATFORM_NAME=agentrix
PLATFORM_ZONE=
PLATFORM_NAME=
FIXTURE_ZONE=
FIXTURE_NAME=

# Sleep (specs/platform/cost.md): `provision.sh sleep --yes` refuses before this time. Set it
# to when judging ends, as 2026-11-20T00:00:00+0300. Empty means nothing sleeps.
SLEEP_NOT_BEFORE=

# Ports and networks. Change only together with the services that use them.
VPC_SUBNET=10.42.0.0
VPC_SUBNET_SIZE=24
NODE_PORT=8080
MODELS_PORT=8090
RUNNER_PORT=7443
EGRESS_PORTS=3128-3191
ROOMS_SUBNET=172.30.0.0/24
ROOMS_GATEWAY=172.30.0.1
ROOMS_IP_RANGE=172.30.0.128/25
FIXTURE_UPSTREAM=127.0.0.1:8081
