#!/usr/bin/env python3
"""copy-lint: checks the words people read against specs/platform/voice.md.

    scripts/copy-lint                 every template, words file, seed and island in the repo
    scripts/copy-lint PATH...         only these files or folders
    scripts/copy-lint --concepts      also concept/*.html (presentation copy, for W7's passes)
    scripts/copy-lint --rules         list the rules

It reads only what a person sees: text between tags, alt/title/placeholder/aria-label values and
meta descriptions in templates; every string in a words or seed JSON file; lines of Markdown and
text templates; prose string literals in JS islands and the Flutter apps (Dart). Template code ({{ }}, {% %}), scripts,
styles, <code>, <pre> and comments are skipped.

Deliberate exceptions go in scripts/copy-lint.allow, one per line, each with a reason:

    path glob | rule | text the finding contains (or *) | why it is allowed

Exit status: 0 clean, 1 findings, 2 a broken allow file or bad arguments.
The lint catches the obvious tells. It doesn't make copy good: read every screen aloud
against voice.md's test before marking it done.
"""

from __future__ import annotations

import fnmatch
import json
import os
import re
import sys
from dataclasses import dataclass, field
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ALLOW_FILE = Path(__file__).resolve().parent / "copy-lint.allow"

# ---------------------------------------------------------------------------------------------
# Rules (voice.md "Never on screen", the website and console copy rules in 01a §6.4, 01b §6.4)
# ---------------------------------------------------------------------------------------------

BANNED_WORDS = [
    "seamless", "seamlessly", "effortless", "effortlessly", "elevate", "elevates", "elevated",
    "empower", "empowers", "empowering", "unlock", "unlocks", "unleash", "unleashes",
    "supercharge", "supercharged", "revolutionize", "revolutionise", "revolutionary",
    "game-changer", "game-changing", "cutting-edge", "state-of-the-art", "next-generation",
    "next-gen", "world-class", "best-in-class", "robust", "leverage", "leverages", "leveraging",
    "utilize", "utilise", "utilizes", "utilises", "delve", "delves", "journey", "journeys",
    "landscape", "tapestry", "vibrant", "testament", "pivotal", "crucial", "foster", "fosters",
    "harness", "harnesses", "streamline", "streamlines", "streamlined", "synergy", "synergies",
    "holistic", "curated", "magic", "magical", "delightful", "delight", "stunning",
    "breathtaking", "nestled",
]
BANNED_PHRASES = [
    "in today's world", "in today’s world", "look no further", "rest assured",
    "we've got you covered", "we’ve got you covered", "at your fingertips",
    "take it to the next level", "something went wrong", "pending approval",
    "your journey", "we're processing your request", "no data available",
]
OPENERS = [
    r"great question", r"absolutely!", r"certainly!", r"i hope this helps", r"let me know if",
    r"happy to help", r"oops", r"uh-oh", r"no worries", r"sure thing", r"lovely\.",
]
# Visitors never see these words for our desks (06 §4.8). "assistant" is fine for a customer's
# own AI; allow it where that is what it means.
VISITOR_TERMS = ["chatbot", "chat bot", "bot", "bots", "assistant", "staff", "pop-up", "popup",
                 "ai concierge", "chatting"]
BUTTON_VERBS = ["submit", "proceed", "continue your journey", "click here", "learn more"]
SHOUTY_FRAGMENTS = re.compile(r"(?:\b[^.!?\n]{1,24}[.!]\s+){2,}[^.!?\n]{1,24}[.!]")

RULES = {
    "banned-word": "A word that marks text as machine-written or as filler (voice.md, Never on screen).",
    "banned-phrase": "A stock phrase voice.md bans, or a vague status that says less than the facts.",
    "opener": "A chatbot opener or closer. Start with the answer; end when it's said.",
    "em-dash": "An em dash in prose. Use a full stop, comma, colon or brackets.",
    "en-dash": "An en dash outside a numeric range. Use 'to', a comma or a full stop.",
    "exclamation": "An exclamation mark. Allowed only in a customer's own words or a real celebration the owner chose (allow it, with the reason).",
    "emoji": "An emoji in product UI. Only where a person typed it.",
    "title-case": "Title Case in a heading, button, label or page title. Use sentence case.",
    "not-x-but-y": "'It's not just X, it's Y' or 'not only … but also' used for drama.",
    "fragments": "A run of short dramatic fragments ('No forms. No waiting. Just answers.').",
    "self-answering": "A question that answers itself ('Ready to grow?').",
    "visitor-term": "A word visitors must never see for a WebAgent (06 §4.8): bot, chatbot, assistant, staff, pop-up, AI concierge, chatting.",
    "button-verb": "A button that isn't a verb the person would say ('Submit', 'Proceed').",
    "currency": "Money in visitor prose is 'KSh 2,400': KSh, a space, thousands separators; never 'KES 2400'.",
}

# Files a visitor reads (the visitor-term and currency rules apply only here).
